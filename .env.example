# ── Landing (phantix.site) ────────────────────────────────────────────────────
# The landing ALWAYS fetches live pricing from the billing endpoint
# (`GET /billing/pricing`). Set VITE_API_BASE so it hits the real API.
# Without it the landing falls back to static default prices.
VITE_API_BASE=https://staging.phantix.site/api/v1

# Cross-surface links (production defaults shown)
# VITE_PLATFORM_URL=https://platform.phantix.site
# VITE_APP_URL=https://app.phantix.site
